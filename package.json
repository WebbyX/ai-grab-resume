{
  "name": "nortia-ai-grab",
  "version": "0.1.0",
  "description": "Local MCP connector that lets your own Claude send resumes from your hiring-platform account into your Nortia workspace.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "bin": {
    "nortia-ai-grab": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test && bash scripts/check-publishable.sh"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.0",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "zod": "4.6.5"
  }
}
